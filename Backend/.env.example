PORT=5001
# MongoDB Atlas connection string (required in production)
MONGO_URI=your_mongo_connection_here
# Long random string used to sign login tokens, e.g. output of: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
# Optional: enables AI-written suggestions (falls back to rule-based ranking without it)
GROQ_API_KEY=your_groq_api_key_here
# Frontend URL(s) allowed to call this API, comma-separated (also used to build share links)
CLIENT_URL=http://localhost:5173
# Optional: OAuth Client ID from Google Cloud Console, enables "Continue with Google" (set the same GOOGLE_CLIENT_ID in the frontend too)
GOOGLE_CLIENT_ID=
